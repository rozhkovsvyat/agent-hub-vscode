{
  "name": "cukii-vscode",
  "icon": "media/icon.png",
  "author": "Cukii",
  "version": "2.0.169",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozhkovsvyat/agent-hub-vscode"
  },
  "extensionKind": [
    "workspace"
  ],
  "bugs": {
    "url": "https://github.com/rozhkovsvyat/agent-hub-vscode/issues"
  },
  "homepage": "https://github.com/rozhkovsvyat/agent-hub-vscode",
  "license": "Apache-2.0",
  "displayName": "Cukii Chat",
  "pricing": "Free",
  "description": "Cukii Chat — one chat for the Claude Code, Codex, Grok, Qwen, Kimi and Cursor CLIs you already pay for",
  "publisher": "cukii",
  "engines": {
    "vscode": "^1.70.0",
    "node": ">=20.20.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Cukii Chat runs the vendor CLIs as agents that read and change files in this folder, so it works only in a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "engine-strict": true,
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agent",
    "chat",
    "claude",
    "codex",
    "qwen",
    "grok",
    "cursor",
    "kimi"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished",
    "onView:continueGUIView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "filenames": [
          "config.json",
          ".continuerc.json"
        ],
        "id": "jsonc"
      },
      {
        "id": "promptLanguage",
        "extensions": [
          ".prompt"
        ],
        "aliases": [
          "Prompt Language"
        ],
        "configuration": "./prompt-file-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "promptLanguage",
        "scopeName": "source.prompt",
        "path": "./media/prompt.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cukii Chat",
      "properties": {
        "continue.telemetryEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Cukii collects anonymous usage data, cleaned of PII, to help us improve the product for our users.",
          "markdownDeprecationMessage": "This setting is deprecated and will be removed in a later version. Please use the _Telemetry > Allow Anonymous Telemetry_ setting in the extension's User Settings page.",
          "deprecationMessage": "Please use the _Telemetry > Allow Anonymous Telemetry_ setting in the extension's User Settings page."
        },
        "continue.showInlineTip": {
          "type": "boolean",
          "default": true,
          "description": "Show inline suggestion to use the Cukii keyboard shortcuts (e.g. \"Cmd/Ctrl L to select code, Cmd/Ctrl I to edit\")."
        },
        "continue.pauseCodebaseIndexOnStart": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Pause Cukii's codebase index on start."
        },
        "cukii.usage.directVendorApi": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also read Claude and Codex limits straight from the vendor's usage API with your stored login. Off by default: Anthropic's terms do not allow third-party apps to handle Claude.ai subscription tokens. When off, Claude limits come from the Claude CLI stream (updated on every turn) and Codex limits from the Codex CLI's own session journal. Takes effect after a window reload."
        },
        "cukii.voiceLanguage": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Language for microphone dictation. `auto` uses the VS Code display language (Russian UI → Russian transcript). `detect` lets Whisper guess the spoken language. Or set a Whisper language such as `ru` / `russian` or `en` / `english`."
        }
      }
    },
    "commands": [
      {
        "command": "cukii.openBridgeSession",
        "category": "Cukii Chat",
        "title": "Open Bridge Session"
      },
      {
        "command": "cukii.recoverBridgeSession",
        "category": "Cukii Chat",
        "title": "Recover Bridge Session"
      },
      {
        "command": "continue.applyCodeFromChat",
        "category": "Cukii Chat",
        "title": "Apply code from chat",
        "group": "Cukii"
      },
      {
        "command": "continue.acceptDiff",
        "category": "Cukii Chat",
        "title": "Accept Diff",
        "group": "Cukii"
      },
      {
        "command": "continue.rejectDiff",
        "category": "Cukii Chat",
        "title": "Reject Diff",
        "group": "Cukii",
        "icon": "$(stop)"
      },
      {
        "command": "continue.acceptVerticalDiffBlock",
        "category": "Cukii Chat",
        "title": "Accept Vertical Diff Block",
        "group": "Cukii"
      },
      {
        "command": "continue.rejectVerticalDiffBlock",
        "category": "Cukii Chat",
        "title": "Reject Vertical Diff Block",
        "group": "Cukii"
      },
      {
        "command": "continue.focusEdit",
        "category": "Cukii Chat",
        "title": "Add to Edit",
        "group": "Cukii"
      },
      {
        "command": "continue.focusCuKiiInput",
        "category": "Cukii Chat",
        "title": "Add Highlighted Code to Context and Clear Chat",
        "group": "Cukii"
      },
      {
        "command": "continue.focusCuKiiInputWithoutClear",
        "category": "Cukii Chat",
        "title": "Add to Chat",
        "group": "Cukii"
      },
      {
        "command": "continue.debugTerminal",
        "category": "Cukii Chat",
        "title": "Debug Terminal",
        "group": "Cukii"
      },
      {
        "command": "continue.exitEditMode",
        "category": "Cukii Chat",
        "title": "Exit Edit Mode",
        "group": "Cukii"
      },
      {
        "command": "continue.openConfigPage",
        "category": "Cukii Chat",
        "title": "Open Settings",
        "icon": "$(gear)",
        "group": "Cukii"
      },
      {
        "command": "continue.toggleTabAutocompleteEnabled",
        "category": "Cukii Chat",
        "title": "Toggle Autocomplete Enabled",
        "group": "Cukii"
      },
      {
        "command": "continue.forceAutocomplete",
        "title": "Cukii Chat: Force Autocomplete",
        "category": "Cukii Chat"
      },
      {
        "command": "continue.selectFilesAsContext",
        "category": "Cukii Chat",
        "title": "Select Files as Context",
        "group": "Cukii"
      },
      {
        "command": "continue.newSession",
        "category": "Cukii Chat",
        "title": "New Session",
        "icon": "$(add)",
        "group": "Cukii"
      },
      {
        "command": "continue.shareSession",
        "category": "Cukii Chat",
        "title": "Share Current Chat Session as Markdown",
        "group": "Cukii"
      },
      {
        "command": "continue.viewLogs",
        "category": "Cukii Chat",
        "title": "View Logs",
        "group": "Cukii"
      },
      {
        "command": "continue.clearConsole",
        "category": "Cukii Chat",
        "title": "Clear Console",
        "icon": "$(clear-all)",
        "group": "Cukii"
      },
      {
        "command": "continue.navigateTo",
        "category": "Cukii Chat",
        "title": "Navigate to a path",
        "group": "Cukii"
      },
      {
        "command": "continue.writeCommentsForCode",
        "category": "Cukii Chat",
        "title": "Write Comments for this Code",
        "group": "Cukii"
      },
      {
        "command": "continue.writeDocstringForCode",
        "category": "Cukii Chat",
        "title": "Write a Docstring for this Code",
        "group": "Cukii"
      },
      {
        "command": "continue.fixCode",
        "category": "Cukii Chat",
        "title": "Fix this Code",
        "group": "Cukii"
      },
      {
        "command": "continue.optimizeCode",
        "category": "Cukii Chat",
        "title": "Optimize this Code",
        "group": "Cukii"
      },
      {
        "command": "continue.fixGrammar",
        "category": "Cukii Chat",
        "title": "Fix Grammar / Spelling",
        "group": "Cukii"
      },
      {
        "command": "continue.codebaseForceReIndex",
        "category": "Cukii Chat",
        "title": "Codebase Force Re-Index",
        "group": "Cukii"
      },
      {
        "command": "continue.rebuildCodebaseIndex",
        "category": "Cukii Chat",
        "title": "Rebuild codebase index",
        "group": "Cukii"
      },
      {
        "command": "continue.docsIndex",
        "category": "Cukii Chat",
        "title": "Docs Index",
        "group": "Cukii"
      },
      {
        "command": "continue.docsReIndex",
        "category": "Cukii Chat",
        "title": "Docs Force Re-Index",
        "group": "Cukii"
      },
      {
        "command": "continue.focusCuKiiInput",
        "category": "Cukii Chat",
        "title": "Focus Cukii Chat",
        "group": "Cukii"
      },
      {
        "command": "continue.enterEnterpriseLicenseKey",
        "category": "Cukii Chat",
        "title": "Enter Enterprise License Key",
        "group": "Cukii"
      },
      {
        "command": "continue.toggleNextEditEnabled",
        "title": "Cukii Chat: Toggle Next Edit"
      },
      {
        "command": "continue.nextEditWindow.hideNextEditSuggestion",
        "category": "Cukii Chat",
        "title": "Hide Next Edit Suggestion"
      },
      {
        "command": "continue.nextEditWindow.acceptNextEditSuggestion",
        "category": "Cukii Chat",
        "title": "Accept Next Edit Suggestion"
      },
      {
        "command": "continue.forceNextEdit",
        "category": "Cukii Chat",
        "title": "Cukii Chat: Force Next Edit"
      },
      {
        "command": "continue.acceptJump",
        "category": "Cukii Chat",
        "title": "Cukii Chat: Accept Jump Suggestion"
      },
      {
        "command": "continue.rejectJump",
        "category": "Cukii Chat",
        "title": "Cukii Chat: Reject Jump Suggestion"
      },
      {
        "command": "continue.openInNewWindow",
        "category": "Cukii Chat",
        "title": "Open Cukii Chat in a New Tab",
        "icon": {
          "light": "media/cukii-title.svg",
          "dark": "media/cukii-title.svg"
        },
        "group": "Cukii"
      },
      {
        "command": "cukii.renameChatPanel",
        "category": "Cukii Chat",
        "title": "Rename Session",
        "group": "Cukii"
      },
      {
        "command": "cukii.installMemoryDiscipline",
        "category": "Cukii Chat",
        "title": "Install Memory Discipline",
        "group": "Cukii"
      }
    ],
    "keybindings": [
      {
        "command": "continue.openInNewWindow",
        "mac": "shift+alt+c u",
        "key": "shift+alt+c u",
        "args": {
          "suppressInitialChordCharacter": true
        },
        "when": "!terminalFocus"
      },
      {
        "command": "continue.openInNewWindow",
        "mac": "ctrl+shift+c u",
        "key": "ctrl+shift+c u",
        "args": {
          "suppressInitialChordCharacter": true
        },
        "when": "!terminalFocus"
      },
      {
        "command": "continue.openInNewWindow",
        "mac": "ctrl+alt+c ctrl+alt+u",
        "key": "ctrl+alt+c ctrl+alt+u",
        "when": "!terminalFocus"
      },
      {
        "command": "continue.focusCuKiiInput",
        "mac": "cmd+l",
        "key": "ctrl+l"
      },
      {
        "command": "continue.focusCuKiiInputWithoutClear",
        "mac": "cmd+shift+l",
        "key": "ctrl+shift+l"
      },
      {
        "command": "continue.acceptDiff",
        "mac": "shift+cmd+enter",
        "key": "shift+ctrl+enter",
        "when": "continue.diffVisible"
      },
      {
        "command": "continue.rejectDiff",
        "mac": "shift+cmd+backspace",
        "key": "shift+ctrl+backspace",
        "when": "continue.diffVisible"
      },
      {
        "command": "continue.rejectDiff",
        "mac": "cmd+z",
        "key": "ctrl+z",
        "when": "continue.diffVisible"
      },
      {
        "command": "continue.acceptVerticalDiffBlock",
        "mac": "alt+cmd+y",
        "key": "alt+ctrl+y",
        "when": "continue.diffVisible"
      },
      {
        "command": "continue.rejectVerticalDiffBlock",
        "mac": "alt+cmd+n",
        "key": "alt+ctrl+n",
        "when": "continue.diffVisible"
      },
      {
        "command": "continue.openInNewWindow",
        "mac": "cmd+k cmd+m",
        "key": "ctrl+k ctrl+m",
        "when": "!terminalFocus"
      }
    ],
    "submenus": [
      {
        "id": "continue.continueSubMenu",
        "label": "Cukii Chat"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "continue.focusCuKiiInput"
        },
        {
          "command": "continue.focusCuKiiInputWithoutClear"
        },
        {
          "command": "continue.debugTerminal"
        },
        {
          "command": "continue.newSession"
        },
        {
          "command": "continue.openInNewWindow"
        },
        {
          "command": "continue.toggleTabAutocompleteEnabled",
          "when": "false"
        },
        {
          "command": "continue.forceAutocomplete",
          "when": "false"
        },
        {
          "command": "continue.toggleNextEditEnabled",
          "when": "false"
        },
        {
          "command": "continue.forceNextEdit",
          "when": "false"
        },
        {
          "command": "continue.acceptJump",
          "when": "false"
        },
        {
          "command": "continue.rejectJump",
          "when": "false"
        },
        {
          "command": "continue.nextEditWindow.hideNextEditSuggestion",
          "when": "false"
        },
        {
          "command": "continue.nextEditWindow.acceptNextEditSuggestion",
          "when": "false"
        },
        {
          "command": "continue.writeCommentsForCode",
          "when": "false"
        },
        {
          "command": "continue.writeDocstringForCode",
          "when": "false"
        },
        {
          "command": "continue.fixCode",
          "when": "false"
        },
        {
          "command": "continue.optimizeCode",
          "when": "false"
        },
        {
          "command": "continue.fixGrammar",
          "when": "false"
        },
        {
          "command": "continue.codebaseForceReIndex",
          "when": "false"
        },
        {
          "command": "continue.rebuildCodebaseIndex",
          "when": "false"
        },
        {
          "command": "continue.docsIndex",
          "when": "false"
        },
        {
          "command": "continue.docsReIndex",
          "when": "false"
        },
        {
          "command": "continue.enterEnterpriseLicenseKey",
          "when": "false"
        },
        {
          "command": "continue.focusEdit",
          "when": "false"
        },
        {
          "command": "continue.exitEditMode",
          "when": "false"
        },
        {
          "command": "continue.applyCodeFromChat",
          "when": "false"
        },
        {
          "command": "continue.openConfigPage",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "continue.continueSubMenu",
          "group": "0_acontinue"
        }
      ],
      "webview/context": [
        {
          "command": "continue.newSession",
          "when": "webviewId == 'continue.continueGUIView' || webviewId == 'cukii.fullScreenChat'"
        },
        {
          "command": "cukii.renameChatPanel",
          "when": "webviewId == 'cukii.fullScreenChat'"
        }
      ],
      "editor/title/run": [
        {
          "command": "continue.rejectDiff",
          "group": "Cukii",
          "when": "continue.streamingDiff"
        }
      ],
      "continue.continueSubMenu": [
        {
          "command": "continue.focusCuKiiInputWithoutClear",
          "group": "Cukii"
        }
      ],
      "explorer/context": [
        {
          "command": "continue.selectFilesAsContext",
          "group": "1_debug@1"
        }
      ],
      "view/title": [
        {
          "command": "continue.clearConsole",
          "group": "navigation@1",
          "when": "view == continue.continueConsoleView"
        }
      ],
      "editor/title": [
        {
          "command": "continue.openInNewWindow",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "cukii.renameChatPanel",
          "when": "webviewId == 'cukii.fullScreenChat'",
          "group": "1_modify"
        }
      ],
      "terminal/context": [
        {
          "command": "continue.debugTerminal",
          "group": "navigation@top"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cukii",
          "title": "Cukii Chat",
          "icon": "media/cukii-activity.svg"
        }
      ],
      "panel": [
        {
          "id": "continueConsole",
          "title": "Cukii Chat Console",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "cukii": [
        {
          "type": "webview",
          "id": "continue.continueGUIView",
          "name": "Cukii Chat",
          "icon": "media/cukii-activity.svg",
          "visibility": "visible"
        }
      ],
      "continueConsole": [
        {
          "type": "webview",
          "id": "continue.continueConsoleView",
          "name": "Cukii Chat Console",
          "icon": "$(window)",
          "visibility": "visible",
          "when": "config.continue.enableConsole"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.continue*/config.json",
        "url": "./config_schema.json"
      },
      {
        "fileMatch": ".continuerc.json",
        "url": "./continue_rc_schema.json"
      },
      {
        "fileMatch": "**/config.yaml",
        "url": "./config-yaml-schema.json"
      }
    ]
  },
  "scripts": {
    "esbuild-base": "node scripts/esbuild.js",
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "esbuild-notify": "npm run esbuild-base -- --sourcemap --notify",
    "esbuild:visualize": "esbuild-visualizer --metadata ./build/meta.json --filename ./build/stats.html --open",
    "tsc": "tsc -p ./",
    "tsc:check": "tsc -p ./ --noEmit",
    "tsc-watch": "tsc -watch -p ./",
    "rebuild": "electron-rebuild -v 19.1.8 node-pty",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "test": "vitest run",
    "test:build-graph": "node --test scripts/build-copy-gui.test.js scripts/package.test.js",
    "test:voice-runtime": "node scripts/test-copy-voice-runtime.js",
    "probe:voice-package": "node scripts/probe-voice-package.js",
    "vitest": "vitest run",
    "write-build-timestamp": "node scripts/write-build-timestamp.js",
    "prepackage": "node scripts/prepackage.js",
    "package": "node scripts/package.js",
    "package-all": "node scripts/package-all.js",
    "package:pre-release": "node scripts/package.js --pre-release",
    "build:rust": "cargo-cp-artifact -ac sync sync.node -- cargo build --manifest-path ../../sync/Cargo.toml --message-format=json-render-diagnostics",
    "build-debug:rust": "npm run build:rust --",
    "build-release:rust": "npm run build:rust -- --release",
    "e2e:compile": "tsc -p ./tsconfig.e2e.json",
    "e2e:build": "npm --prefix ../../gui run build && npm run package",
    "e2e:create-storage": "mkdir -p ./e2e/storage",
    "e2e:get-chromedriver": "extest get-chromedriver --storage ./e2e/storage --code_version 1.95.0",
    "e2e:get-vscode": "extest get-vscode --storage ./e2e/storage --code_version 1.95.0",
    "e2e:sign-vscode": "codesign --entitlements entitlements.plist --deep --force -s - './e2e/storage/Visual Studio Code.app'",
    "e2e:copy-vsix": "chmod +x ./e2e/get-latest-vsix.sh && bash ./e2e/get-latest-vsix.sh",
    "e2e:install-vsix": "extest install-vsix -f ./e2e/vsix/continue.vsix --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage",
    "e2e:install-extensions": "extest install-from-marketplace ms-vscode-remote.remote-ssh --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage && extest install-from-marketplace ms-vscode-remote.remote-containers --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage && extest install-from-marketplace ms-vscode-remote.remote-wsl --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage",
    "e2e:test": "NODE_ENV=e2e extest run-tests ${TEST_FILE:-'./e2e/_output/tests/*.test.js'} --code_settings settings.json --extensions_dir ./e2e/.test-extensions --storage ./e2e/storage",
    "e2e:clean": "rm -rf ./e2e/_output ./e2e/storage",
    "e2e:all": "npm run e2e:build && npm run e2e:compile && npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode && npm run e2e:sign-vscode && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:all-non-mac": "npm run e2e:build && npm run e2e:compile && npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:recompile-extension": "npm run package && npm run e2e:compile && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:rebuild-gui": "rm -rf gui && cp -r ../../gui/dist gui && npm run package && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:quick": "npm run e2e:compile && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test && npm run e2e:clean",
    "e2e:ci:download": "npm run e2e:create-storage && npm run e2e:get-chromedriver && npm run e2e:get-vscode",
    "e2e:ci:run": "npm run e2e:compile && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue npm run e2e:test",
    "e2e:ci:run-yaml": "npm run e2e:compile && npm run e2e:copy-vsix && npm run e2e:install-vsix && npm run e2e:install-extensions && CONTINUE_GLOBAL_DIR=e2e/test-continue-yaml npm run e2e:test"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.4",
    "@nestjs/common": "^11.0.16",
    "@openapitools/openapi-generator-cli": "^2.23.1",
    "@types/chai": "^5.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/follow-redirects": "^1.14.4",
