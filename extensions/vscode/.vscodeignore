.vscode/**
.vscode-test/**
build/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
**/.env
**/env
node_modules/**

**/.pytest_cache
**/__pycache__

manual-testing-sandbox
esbuild.js
importMetaUrl.js
scripts
models/whisper-base/**
e2e

server/exe/**
# VSCE collects ignores and re-includes as separate sets, so a bare `/**`
# re-include would override `**/*.map` regardless of line order.
!out/node_modules/**/!(*.map)
!out/runtime/**/!(*.map)
!node_modules/@vscode/ripgrep/bin/rg

# Do not ship esbuild in VSIX
out/node_modules/esbuild/**
out/node_modules/@esbuild/**
